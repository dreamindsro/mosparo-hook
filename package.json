{
  "name": "@dreamind-tools/mosparo-hook",
  "version": "0.5.4",
  "type": "module",
  "description": "React and Next.js integration for mosparo spam protection: form field, hook and server-side verification",
  "license": "MIT",
  "keywords": [
    "mosparo",
    "spam",
    "captcha",
    "react",
    "nextjs",
    "form",
    "spam-protection",
    "anti-spam"
  ],
  "homepage": "https://github.com/dreamindsro/mosparo-hook#readme",
  "bugs": {
    "url": "https://github.com/dreamindsro/mosparo-hook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamindsro/mosparo-hook.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "npm run build && rm -rf examples/next/node_modules/@dreamind-tools && npm --prefix examples/next install"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mosparo/api-client": "^2.0.0"
  },
  "sideEffects": false
}
