{
  "name": "@dreamind-tools/mosparo-hook",
  "version": "0.5.4",
  "type": "module",
  "description": "React/Next.js integration for mosparo spam protection",
  "license": "MIT",
  "keywords": [
    "mosparo",
    "spam",
    "captcha",
    "react",
    "nextjs",
    "form",
    "spam-protection",
    "anti-spam"
  ],
  "homepage": "https://github.com/dreamindsro/mosparo-hook#readme",
  "bugs": {
    "url": "https://github.com/dreamindsro/mosparo-hook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamindsro/mosparo-hook.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mosparo/api-client": "^1.2.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@mosparo/api-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mosparo/api-client": "^1.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@8.15.1+sha1.8adba2d20330c02d3856e18c4eb3819d1d3ca6aa"
}
